    "@react-navigation/native": "^7.1.8",
    "axios": "^1.15.0",
    "bcryptjs": "^3.0.3",
    "expo": "~56.0.20",
    "expo-build-properties": "~56.0.26",
    "expo-constants": "^56.0.16",
    "expo-dev-client": "~56.0.25",
    "expo-file-system": "~56.0.10",
    "expo-font": "~56.0.7",
